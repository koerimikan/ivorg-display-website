---
import { coverSVG } from '../lib/artwork.js';
---
<footer class="audio-deck" aria-label="专辑试听播放器" data-grid="ALBUM AUDIO DECK">
<div class="deck-track"><div class="deck-cover" id="deck-cover" aria-hidden="true" set:html={coverSVG(0)} /><div class="deck-track-info"><div class="deck-track-name" id="deck-track-name">UNHEARD / 未闻之境</div><div class="deck-credit" id="deck-credit">IVORG-01 / SYNTH PREVIEW</div></div></div>
<div class="transport"><button type="button" id="previous-track" aria-label="上一首">‹</button><button type="button" id="play-button" class="play" aria-label="播放当前曲目" aria-pressed="false">▶</button><button type="button" id="next-track" aria-label="下一首">›</button></div>
<div class="deck-progress"><div class="deck-times"><span id="elapsed">00:00</span><span id="duration">00:32</span></div><input id="seek" type="range" min="0" max="1000" value="0" step="1" aria-label="播放进度"></div>
<div class="spectrum-cell"><canvas id="spectrum" aria-label="实时音频频谱"></canvas><span class="bpm-label" id="bpm">120<small>BPM</small></span></div>
<div class="deck-tools"><div class="volume"><button type="button" id="mute-button" aria-label="静音" aria-pressed="false">◖</button><input id="volume" type="range" min="0" max="1" step="0.01" value="0.65" aria-label="音量"></div><label class="local-upload" title="挂载本地音频">LOCAL<br>＋<input id="local-audio" type="file" accept="audio/*" aria-label="挂载本地音频"></label><button type="button" id="motion-toggle" class="motion-toggle" aria-pressed="true" aria-label="切换展示动效">MOTION<br>ON</button></div>
</footer>
---
// The transition is a printed sheet: a blue field with three cropped poster
// strips (greyscale + multiply, so they read as halftone) and the catalogue
// slug. motion.js sweeps its clip-path and shuffles the strips.
const strips = [
  { src: '/artwork/event-1st-meeting.webp', pos: '20% 24%' },
  { src: '/artwork/event-3rd-meeting.webp', pos: '50% 16%' },
  { src: '/artwork/event-4th-meeting.webp', pos: '80% 22%' }
];
---
<div class="page-wipe" id="page-wipe" aria-hidden="true" transition:persist="ivorg-wipe">
  <div class="wipe-strips">{strips.map(strip => <i style={`background-image:url('${strip.src}');background-position:${strip.pos}`}></i>)}</div>
  <div class="wipe-halftone"></div>
  <div class="wipe-copy">
    <span class="micro">CAT // IVORG-0001</span>
    <span class="wipe-word">IVORG.</span>
    <span class="micro">ILLINOIS VOCALOID RESEARCH GROUP / UIUC</span>
  </div>
  <span class="wipe-reg tl" aria-hidden="true"></span>
  <span class="wipe-reg br" aria-hidden="true"></span>
</div>

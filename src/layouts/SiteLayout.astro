---
import { ClientRouter } from 'astro:transitions';
import PageWipe from '../components/PageWipe.astro';
import '../styles/shell.css';
const { title, page } = Astro.props;
const links = [{ path: '/', key: 'home', text: '01 // HOME' }, { path: '/discography/', key: 'discography', text: '02 // DISCOGRAPHY' }, { path: '/newsletter/', key: 'newsletter', text: '03 // NEWSLETTER' }];
---
<!doctype html>
<html lang="zh-CN" data-wipe-tint="on">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="theme-color" content="#F4F2EC" />
  <meta name="description" content="Illinois Vocaloid Research Group (IVORG) at UIUC — vocal synthesis, song sharing and workshops. First release: IVORG Index Zero." />
  <title>{title} — IVORG</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@800&family=Oswald:wght@700&family=Inter:wght@400;600&family=Noto+Sans+SC:wght@400;700;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <ClientRouter fallback="swap" />
</head>
<body data-page={page}>
<a class="skip" href="#page-content">Skip to content</a>
<header class="topbar" data-grid="TOP BAR">
  <a class="brand" href="/" aria-label="IVORG home"><span class="wordmark">IVORG<sup>✳</sup></span><span class="live micro"><i class="led" aria-hidden="true"></i><span>ON AIR</span></span></a>
  <nav class="nav" aria-label="Site sections">{links.map(link => <a class="nav-link" href={link.path} aria-current={page === link.key ? 'page' : undefined}>{link.text}</a>)}</nav>
  <div class="system"><time class="clock micro" id="system-clock" aria-label="Chicago system time">CHI // --:--:--</time><button id="motion-toggle" class="grid-toggle" type="button" aria-pressed="true" aria-label="Toggle motion">MOTION<br />ON</button><button id="grid-toggle" class="grid-toggle" type="button" aria-pressed="false" aria-label="Turn grid inspector on"><span class="grid-symbol" aria-hidden="true">{Array.from({length:9},()=> <i></i>)}</span><span id="grid-label">GRID</span></button></div>
</header>
<main class="stage" id="page-content" transition:animate="none"><slot /></main>
<svg class="noise" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><filter id="film-noise"><feTurbulence type="fractalNoise" baseFrequency=".76" numOctaves="3" stitchTiles="stitch" /></filter><rect width="100%" height="100%" filter="url(#film-noise)" /></svg>
<div class="cross-layer" id="cross-layer" aria-hidden="true"></div><div class="inspector" id="inspector" aria-hidden="true" hidden></div>
<PageWipe />
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script>import '../scripts/app.js';</script>
<script>
  if (import.meta.env.DEV) import('../dev-studio/index.js');
</script>
</body>
</html>

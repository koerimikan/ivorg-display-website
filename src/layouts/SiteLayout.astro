---
import { ClientRouter } from 'astro:transitions';
import '../styles/shell.css';
const { title, page } = Astro.props;
const links = [{ path: '/', key: 'home', text: '01 // HOME' }, { path: '/discography/', key: 'discography', text: '02 // DISCOGRAPHY' }, { path: '/newsletter/', key: 'newsletter', text: '03 // NEWSLETTER' }];
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="theme-color" content="#090A0C" />
  <meta name="description" content="IVORG — 合成歌声、电子音乐与独立创作共同体。" />
  <title>{title} — IVORG</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@800&family=Oswald:wght@700&family=Inter:wght@400;600&family=Noto+Sans+SC:wght@400;700;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <ClientRouter fallback="swap" />
</head>
<body data-page={page}>
<a class="skip" href="#page-content">跳至主内容</a>
<header class="topbar" data-grid="TOP BAR">
  <a class="brand" href="/" aria-label="IVORG 主页"><span class="wordmark">IVORG<sup>✳</sup></span><span class="live micro"><i class="led" aria-hidden="true"></i><span>ON AIR</span></span></a>
  <nav class="nav" aria-label="社团官网板块">{links.map(link => <a class="nav-link" href={link.path} aria-current={page === link.key ? 'page' : undefined}>{link.text}</a>)}</nav>
  <div class="system"><time class="clock micro" id="system-clock" aria-label="芝加哥系统时间">CHI // --:--:--</time><button id="grid-toggle" class="grid-toggle" type="button" aria-pressed="false" aria-label="开启网格检视"><span class="grid-symbol" aria-hidden="true">{Array.from({length:9},()=> <i></i>)}</span><span id="grid-label">GRID</span></button></div>
</header>
<main class="stage" id="page-content" transition:animate="none"><slot /></main>
<div class="ticker" data-grid="MANIFESTO TICKER" aria-label="Synthesize the unheard. Vocaloid and electronic music collective."><div class="ticker-track" aria-hidden="true">{[0,1].map(()=> <span class="ticker-copy">SYNTHESIZE THE UNHEARD <b>✳</b> VOCALOID &amp; ELECTRONIC MUSIC COLLECTIVE <b>//</b> INDEPENDENT VOICES. ORIGINAL FREQUENCIES. <b>↗</b> SOUND IS OUR COMMON GROUND <b>✳</b></span>)}</div></div>
<svg class="noise" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><filter id="film-noise"><feTurbulence type="fractalNoise" baseFrequency=".76" numOctaves="3" stitchTiles="stitch" /></filter><rect width="100%" height="100%" filter="url(#film-noise)" /></svg>
<div class="cross-layer" id="cross-layer" aria-hidden="true"></div><div class="inspector" id="inspector" aria-hidden="true" hidden></div>
<div class="page-wipe" id="page-wipe" aria-hidden="true" transition:persist="ivorg-wipe"><span>IVORG.</span></div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script>import '../scripts/app.js';</script>
</body>
</html>

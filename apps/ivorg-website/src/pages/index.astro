---
import SiteLayout from '../layouts/SiteLayout.astro';
import Ruler from '../components/Ruler.astro';
import { ORG, RELEASE, TRACKS, formatDuration } from '../lib/release.js';
import '../styles/home.css';
---
<SiteLayout title="Synthesize the Unheard" page="home">
<section class="view home">
<Ruler />
<div class="home-manifesto" data-grid="MANIFESTO">
<div class="background-01" aria-hidden="true">01</div>
<div class="intro-meta"><span class="slash" aria-hidden="true"><i></i><i></i></span><span class="label acid">{ORG.name} / {ORG.affiliation}</span></div>
<h1 class="hero-title" aria-label="Synthesize the unheard."><span class="title-line"><span class="reveal" data-decode="SYNTHESIZE" aria-hidden="true">SYNTHESIZE</span></span><span class="title-line"><span class="reveal outline" data-decode="THE" aria-hidden="true">THE</span></span><span class="title-line"><span class="reveal" data-decode="UNHEARD." aria-hidden="true">UNHEARD.</span></span></h1>
<p class="home-copy"><strong>Synthesize it, then sing it together.</strong>{ORG.name} is the Vocaloid research group at {ORG.affiliation}: we share songs, argue about tuning and arrangement, and put out records as a group.<br />First release: {RELEASE.title}, catalogue {RELEASE.catalogNumber}, {TRACKS.length} tracks.</p>
<div class="action-row"><a class="text-link" href="/discography/">Enter the sound archive <span class="arrow" aria-hidden="true">↗</span></a><a class="text-link" href="/newsletter/">Events &amp; newsletter <span class="arrow" aria-hidden="true">↗</span></a></div>
<div class="manifesto-foot"><span class="barcode" aria-hidden="true"></span><span class="micro">VOCALOID &amp; SYNTHESIS<br /><span class="muted">{ORG.name} / {ORG.affiliation}</span></span></div>
</div>
<div class="home-foci" id="home-foci" data-grid="FEATURED / PARALLAX">
<div class="foci-top"><span class="micro">{RELEASE.catalogNumber} / 2026</span><span class="micro acid">FEATURED RELEASE ↘</span></div>
<div class="halftone" aria-hidden="true"></div><div class="giant-word" aria-hidden="true">SOUND</div>
<span class="coords tl" data-coord="tl">X 0.500 / Y 0.500</span><span class="coords tr" data-coord="tr">U 0.500 / V 0.500</span>
<div class="poster-stack" id="poster-stack">
<article class="feature-poster"><div class="poster-inner"><div class="poster-art"><picture><source srcset={RELEASE.cover.avif} type="image/avif" /><img src={RELEASE.cover.webp} srcset={`${RELEASE.cover.small} 640w, ${RELEASE.cover.webp} 1280w`} sizes="(max-width: 730px) 72vw, 38vw" width={RELEASE.cover.width} height={RELEASE.cover.height} alt={`${RELEASE.title} cover art`} decoding="async" /></picture></div><div class="poster-note"><span class="micro">CAT // {RELEASE.catalogNumber}</span><a href="/discography/" aria-label={`View the release ${RELEASE.title}`}><span class="arrow">↗</span></a></div></div></article>
<article class="bulletin-poster tracklist"><div class="bulletin-issue micro"><span>{RELEASE.graphicTitle}</span><span>07</span></div><h2>SONG<br />LIST.</h2><ol class="bulletin-list">{TRACKS.map(track => <li><span>{track.title}</span><b>{formatDuration(track.seconds)}</b></li>)}</ol><a href="/discography/" class="poster-open"><span>VIEW THE RELEASE</span><span class="arrow" aria-hidden="true">↗</span></a></article>
</div>
<span class="poster-caption micro">FEATURED RELEASE × FULL TRACKLIST</span><span class="coords bl" data-coord="bl">ΔX +0.000 / ΔY +0.000</span><span class="coords br" data-coord="br">NORM / [0 → 1]</span>
</div>
</section>
</SiteLayout>

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IVORG Atelier Lab",
  "version": "1.0.0",
  "identifier": "org.ivorg.companion",
  "build": {
    "devUrl": "http://127.0.0.1:4323/?study=rhine",
    "frontendDist": "assets"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "IVORG / ATELIER LAB",
        "create": false,
        "url": "http://127.0.0.1:4323/?study=rhine",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 800,
        "theme": "Dark",
        "decorations": true
      }
    ],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; frame-src http://127.0.0.1:4321; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/node-runtime"
    ],
    "resources": {
      ".stage/project/": "project/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "zlib"
      }
    }
  }
}

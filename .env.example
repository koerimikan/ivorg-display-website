# Copy the variables you need into your shell or a local .env (never commit real values).
# PowerShell: $env:NAME = "value"    bash: export NAME=value

# --- IVORG website (public build) ---
# Absolute production origin, used for canonical URLs, og:image and sitemap.xml.
# When unset, the build omits sitemap.xml and the release check (npm run verify:release) fails.
IVORG_SITE_URL=https://ivorg.net

# --- Atelier workbench Agent (optional) ---
# Absolute path to a trusted, already built DeepSeek Harness checkout.
# Used by `npm run agent:configure` when --harness is not passed.
DSH_HARNESS_PATH=
# Operator override of the configured harness root at runtime (optional).
COMPANION_DSH_ROOT=
# Model provider credentials: only read from the environment.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
COMPANION_DSH_MODEL=
COMPANION_DSH_MAX_TOKENS=
